# Copy to .env.local. Server and worker use this file. Never commit real values.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ZIP_BUCKET=website-zips
SUPABASE_MEDIA_BUCKET=website-media
GOOGLE_MAPS_API_KEY=
EXA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Lovable MCP requires OAuth, not an API key. Run npm run lovable:auth.
LOVABLE_MCP_URL=https://mcp.lovable.dev
LOVABLE_WORKSPACE_ID=
LOVABLE_OAUTH_CLIENT_ID=
LOVABLE_OAUTH_CLIENT_SECRET=
LOVABLE_OAUTH_TOKENS=
# Create an organization API key and project at terac.com. Server-side only.
TERAC_API_KEY=
TERAC_PROJECT_ID=
# All-in maximum per sales assignment, reserved before recruitment. Quotes above it never launch.
TERAC_MAX_TASK_COST_USD=20
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
SENDER_NAME=Sidewalk AI
SENDER_POSTAL_ADDRESS=
# Resend verified domain ID for sales and buyer delivery emails
RESEND_DOMAIN_ID=
# Generate a long random value, e.g. openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=
# Honest cost estimates; set from your provider plans before starting a run.
COST_PLACES_SEARCH_USD=0.04
COST_EXA_SEARCH_USD=0.01
COST_MODEL_RESEARCH_USD=0.10
COST_LOVABLE_BUILD_USD=3
COST_LOVABLE_REPAIR_USD=1
SALE_PRICE_USD=199
PAYMENT_FEE_PERCENT=3
PAYMENT_FEE_FIXED_USD=0.30
# Comma-separated emails to flag internal verification transactions
INTERNAL_BUYER_EMAILS=
